mixin Contact
  +Section.pb-0(style="margin-top:-17rem")
    .container-fluid
      .row
        .col-md-4
          h4.mb-6 Ing. Jitka Tejnorová
          p
            i.fas.fa-map-marker-alt.me-3 
            |Na Dubech 122
            br 
            |Hradec Králové 50341
          p
            i.fas.fa-envelope-open.me-3
            a(href="mailto:jitka.tejnorova@seznam.cz") jitka.tejnorova@seznam.cz
          .space 
          iframe(style="border:none" src="https://en.frame.mapy.cz/s/cesakobedu" width="400" height="280" frameborder="0")
        .col-md-8 
          h4.mb-6 Napište mě
          form(name="sentMessage" id="contactForm" action="mailto:jitka.tejnorova@seznam.cz" method="post" novalidate)
            d.row 
              d.col-md6
                d.form-group 
                  input(type="text" id="name" class="form-control" placeholder="Jméno" required="required")
                  p.help-block.text-danger
              d.col-md6
                d.form-group 
                  input(type="email" id="email" class="form-control" placeholder="Email" required="required")
                  p.help-block.text-danger
            .form-group
              textarea(name="message" id="message" class="form-control" rows="4" placeholder="Zpráva" required="")
              p.help-block.text-danger
            div(id="succes")
            button(type="submit" class="btn btn-default") Odeslat zprávu
      

            